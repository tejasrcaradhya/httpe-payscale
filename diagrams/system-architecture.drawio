<mxfile host="app.diagrams.net">
  <diagram name="System Architecture" id="httpe-arch">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="boundary" value="AWS ap-south-1 (Mumbai) — RBI Data Residency Boundary (all payment data stays within India)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;fontSize=12;fontColor=#666666;spacingTop=5;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="860" height="730" as="geometry" />
        </mxCell>

