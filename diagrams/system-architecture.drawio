        </mxCell>

        <mxCell id="n2" value="Load Balancer&#10;(AWS ALB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
